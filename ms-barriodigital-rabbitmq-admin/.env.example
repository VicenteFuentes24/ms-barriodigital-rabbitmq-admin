# Export variables in PowerShell or use Compose --env-file. Spring does not auto-load .env.
SERVER_PORT=8088
SERVER_ADDRESS=127.0.0.1
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_ADDRESSES=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=barriodigital
RABBITMQ_SSL_ENABLED=false
BARRIODIGITAL_NETWORK_NAME=infra-barriodigital_barriodigital-net

# Separate HTTP service account; never reuse Azure/Supabase/broker credentials.
ADMIN_HTTP_USERNAME=
# Minimum 16 characters, maximum 72 UTF-8 bytes; do not commit actual values.
ADMIN_HTTP_PASSWORD=

# Opt-in tests only; require management administrator to create a TEMPORARY vhost.
RABBITMQ_ADMIN_INTEGRATION_TEST=false
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
